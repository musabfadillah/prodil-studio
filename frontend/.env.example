# Production Hostinger VPS Backend API URL (or local development)
# When deploying frontend to Vercel, set this in Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://api.yourdomain.com (or http://YOUR_VPS_IP:5000)
VITE_API_URL=http://localhost:5000
# Google OAuth Web client ID (also configure the same value as GOOGLE_CLIENT_ID on the backend)
VITE_GOOGLE_CLIENT_ID=
