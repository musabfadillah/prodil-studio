# Server Configuration
PORT=5000
NODE_ENV=production
# Frontend URL on Vercel (or comma-separated URLs)
FRONTEND_URL=https://prodil-studio.vercel.app,http://localhost:3000,http://localhost:5173

# JWT Secret for User Authentication
JWT_SECRET=prodil_studio_super_secret_jwt_key_change_this_in_production_2026
JWT_EXPIRES_IN=7d

# PostgreSQL Database (VPS Hostinger or Local)
# If Hostinger VPS: postgres://username:password@localhost:5432/prodildb
DATABASE_URL=postgres://postgres:password123@localhost:5432/prodil_studio
PGUSER=postgres
PGPASSWORD=password123
PGHOST=localhost
PGPORT=5432
PGDATABASE=prodil_studio

# Google Gemini API Key (protect quota behind authentication)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Verification (SMTP for Hostinger or Gmail or Resend)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM="Prodil Studio" <no-reply@yourdomain.com>

# Google OAuth Client ID (for Google Sign-in Verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
